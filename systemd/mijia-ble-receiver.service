[Unit]
Description=Local Xiaomi/Mijia BLE advertisement receiver
Wants=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/mijia-ble-bridge.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mijia-ble-bridge/.venv/bin/python -u /opt/mijia-ble-bridge/src/mijia_ble_receiver.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=mijia-ble-bridge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/mijia-ble-bridge

[Install]
WantedBy=multi-user.target
