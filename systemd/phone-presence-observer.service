[Unit]
Description=Optional phone AVRCP presence observer (never controls a plug)
Wants=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/mijia-ble-bridge.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mijia-ble-bridge/.venv/bin/python -u /opt/mijia-ble-bridge/src/phone_presence_observer.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=mijia-ble-bridge-presence
RuntimeDirectoryMode=0750
ReadWritePaths=/run/mijia-ble-bridge-presence

[Install]
WantedBy=multi-user.target
