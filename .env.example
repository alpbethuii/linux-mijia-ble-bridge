# Copy to /etc/mijia-ble-bridge.env and edit locally. Never commit the real file.
# Use the sensor's actual Bluetooth address, not this placeholder.
MIJIA_SENSOR_MAC=XX:XX:XX:XX:XX:XX
# MJWSD06MMC / Xiaomi Temperature and Humidity Monitor 3 Mini; adjust for other models.
MIJIA_PRODUCT_ID=0x55B5
MIJIA_BINDKEY_PATH=/etc/mijia-ble-bridge/bindkey
MIJIA_STATE_PATH=/var/lib/mijia-ble-bridge/advertisement-state.json

# Optional separate phone-presence observer. Not required for sensor reception.
PHONE_BT_ADDRESS=XX:XX:XX:XX:XX:XX
PHONE_BT_SUBJECT=paired_phone
PHONE_PRESENCE_STATE_DIR=/run/mijia-ble-bridge-presence
